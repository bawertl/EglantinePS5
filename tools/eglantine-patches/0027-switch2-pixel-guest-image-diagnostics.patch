diff --git a/src/video_core/host1x/nx2_video_decoder.cpp b/src/video_core/host1x/nx2_video_decoder.cpp
--- a/src/video_core/host1x/nx2_video_decoder.cpp
+++ b/src/video_core/host1x/nx2_video_decoder.cpp
@@ -137,4 +137,24 @@
             ++decoded_frames;
+            if (decoded_frames <= 3 || decoded_frames % 600 == 0) {
+                // The first plane is luma for the expected AV1 YUV formats. Never dereference
+                // a missing/negative-stride plane or an out-of-range pixel.
+                if (f->data[0] != nullptr && f->linesize[0] > 0 && f->width > 0 && f->height > 0 &&
+                    f->width <= f->linesize[0]) {
+                    const size_t center = static_cast<size_t>(f->height / 2) *
+                                          static_cast<size_t>(f->linesize[0]) +
+                                          static_cast<size_t>(f->width / 2);
+                    const u8 center_y = f->data[0][center];
+                    const u8 corner_y = f->data[0][0];
+                    LOG_INFO(HW_GPU,
+                             "[PIXEL-DIAG] decoded={} pts={} fmt={} {}x{} stride={} y_center={} y_corner={}",
+                             decoded_frames, pts, f->format, f->width, f->height,
+                             f->linesize[0], center_y, corner_y);
+                } else {
+                    LOG_WARNING(HW_GPU,
+                                "[PIXEL-DIAG] decoded={} no safely sampleable plane0: {}x{} stride={}",
+                                decoded_frames, f->width, f->height, f->linesize[0]);
+                }
+            }
             if (decoded_frames <= 3 || decoded_frames % 120 == 0) {
                 LOG_INFO(HW_GPU, "[AV1-DIAG] decoded frame={} width={} height={} pts={}",
                          decoded_frames, f->width, f->height, pts);
