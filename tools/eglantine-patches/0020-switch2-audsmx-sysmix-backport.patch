+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Compatible port of Lichii 09b78bd2... sysmix ring transport to pinned Core 3140648...
+// Unlike upstream, the pinned sink has no StreamType::Sysmix/IsReady/
+// TryAppendOutputBlock and Memory has no Read32Acquire. Use StreamType::Out,
+// an explicit 4-block admission bound and validated ReadBlock + CAS instead.
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <mutex>
+#include <span>
