+    void SetNativeEventVsync(u32 index, bool enabled) {
+        if (index >= m_native_events.size() || m_native_events[index] == nullptr) {
+            return;
+        }
+        auto* const event = m_native_events[index];
+        std::scoped_lock lk{m_vsync->mutex};
+        auto& events = m_vsync->events;
+        const auto it = std::find(events.begin(), events.end(), event);
+        if (enabled && it == events.end()) {
+            events.push_back(event);
+        } else if (!enabled && it != events.end()) {
+            events.erase(it);
+        }
+    }
