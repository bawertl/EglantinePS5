diff --git a/src/video_core/nx2.h b/src/video_core/nx2.h
--- a/src/video_core/nx2.h
+++ b/src/video_core/nx2.h
@@ -22,4 +22,47 @@
 // The running title, for the few places that must behave differently per game.
 inline std::atomic<u64> g_nx2_program_id{0};
+
+// V1.000.013 diagnostic only: recent CPU/device address pairs of decoder image buffers.
+// This records addresses, but does not alter GPU mappings or shader execution.
+struct Nx2VideoDiagnosticRange {
+    std::atomic<u64> cpu{};
+    std::atomic<u64> gpu{};
+    std::atomic<u64> size{};
+};
+inline std::array<Nx2VideoDiagnosticRange, 16> g_nx2_video_diagnostic_ranges{};
+
+inline void Nx2RecordVideoDiagnosticRange(u64 cpu, u64 gpu, u64 size) {
+    if (cpu == 0 || size == 0) {
+        return;
+    }
+    auto& range = g_nx2_video_diagnostic_ranges[(cpu >> 12) %
+                                                g_nx2_video_diagnostic_ranges.size()];
+    range.size.store(0, std::memory_order_release);
+    range.cpu.store(cpu, std::memory_order_relaxed);
+    range.gpu.store(gpu, std::memory_order_relaxed);
+    range.size.store(size, std::memory_order_release);
+}
+
+inline bool Nx2MatchesVideoDiagnosticRange(u64 cpu, u64 gpu, u64 size) {
+    if (size == 0) {
+        return false;
+    }
+    const auto overlaps = [](u64 first, u64 length, u64 candidate, u64 candidate_size) {
+        return first != 0 && candidate != 0 &&
+               (first <= candidate ? candidate - first < length
+                                   : first - candidate < candidate_size);
+    };
+    for (const auto& range : g_nx2_video_diagnostic_ranges) {
+        const u64 length = range.size.load(std::memory_order_acquire);
+        if (length == 0) {
+            continue;
+        }
+        if (overlaps(range.cpu.load(std::memory_order_relaxed), length, cpu, size) ||
+            overlaps(range.gpu.load(std::memory_order_relaxed), length, gpu, size)) {
+            return true;
+        }
+    }
+    return false;
+}
 
