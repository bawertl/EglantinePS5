+// Switch 2 TIPC placeholder with fully initialized output words, as in the
+// 2026-11-07 PC core. The older auto-stub returned only a success result,
+// leaving SDK output data unchanged (potentially invalid enums and handles).
+// Use only for explicit compatibility handlers, not all existing HLE services.
+inline void TipcReplyZeroed(HLERequestContext& ctx) {
+    constexpr std::array<u32, 32> zeros{};
+    TipcReplyWords(ctx, std::span<const u32>{zeros});
+}
